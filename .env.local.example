# Venice AI — https://venice.ai
# Option 1: API Key (traditional)
VENICE_API_KEY=vapi_your_key_here
VENICE_MODEL=llama-3.3-70b

# Option 2: x402 Wallet Auth (recommended for agents)
# Uses USDC on Base or Solana. No API key needed.
# Get wallet key from your agent's wallet
X402_WALLET_KEY=

# Session EOA for ERC-7715 permission recipient (generate a throwaway key)
# Example: openssl rand -hex 32
SESSION_ACCOUNT_PRIVATE_KEY=your_private_key_here

# Tatum API — https://tatum.io
# Malicious address detection, transaction simulation, gas pump, fee estimation
# Notifications, portfolio tracking, Web3 name service
TATUM_API_KEY=

# Optional: 1Shot API (mainnet relayer for gasless execution)
# Get key from https://1shotapi.com
ONESHOT_API_KEY=

# Optional: WalletConnect project ID
# NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Sepolia RPC URL (for on-chain execution)
# Default: https://rpc.ankr.com/eth_sepolia
SEPOLIA_RPC_URL=https://rpc.ankr.com/eth_sepolia

# USDC Contract Address on Sepolia
# Default: 0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
USDC_CONTRACT_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# App URL (for API calls)
NEXT_PUBLIC_APP_URL=http://localhost:3000
