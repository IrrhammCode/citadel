# Venice AI — https://venice.ai
VENICE_API_KEY=vapi_your_key_here
VENICE_MODEL=llama-3.3-70b

# Session EOA for ERC-7715 permission recipient (generate a throwaway key)
# Example: openssl rand -hex 32
SESSION_ACCOUNT_PRIVATE_KEY=0x_your_private_key_here

# Optional: WalletConnect project ID
# NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Optional: 1Shot API (mainnet relayer — not required for Sepolia MVP)
# ONESHOT_API_KEY=
# ONESHOT_API_SECRET=
