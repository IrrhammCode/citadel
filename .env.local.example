# ─── Production (required when NODE_ENV=production) ───────────
DATABASE_URL=postgresql://citadel:citadel@localhost:5432/citadel
REDIS_URL=redis://localhost:6379
CITADEL_API_SECRET=change_me_min_16_chars
CRON_SECRET=change_me_cron_secret

# ─── Venice AI ────────────────────────────────────────────────
VENICE_API_KEY=vapi_your_key_here
VENICE_MODEL=llama-3.3-70b
X402_WALLET_KEY=
X402_BUDGET_USD=50

# ─── On-chain execution ───────────────────────────────────────
SESSION_ACCOUNT_PRIVATE_KEY=your_private_key_here
SEPOLIA_RPC_URL=https://rpc.ankr.com/eth_sepolia
USDC_CONTRACT_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# ─── Notifications (required in production) ───────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ONESHOT_WEBHOOK_SECRET=change_me_webhook_hmac

# ─── CFO wallet signatures (REQUIRED in production) ───────────
CFO_ALLOWED_SIGNERS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# CITADEL_REQUIRE_WALLET_APPROVAL=true

# ─── E2E / CI only ────────────────────────────────────────────
# E2E_MOCK_VENICE=true
# E2E_CFO_PRIVATE_KEY=0x...

# ─── Optional integrations ────────────────────────────────────
TATUM_API_KEY=
ONESHOT_API_KEY=
REPORT_SPEND_THRESHOLD=5
BRAIN_CACHE_TTL_MINUTES=5

# ─── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false

# Local infra: npm run infra:up && npm run db:migrate
